{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bygeorgia-net",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "bygeorgia.net",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
